# A project saved before the BDs had sends (sound revision 2: the 909 BD's PAN at 8, the 808 BD's at 7)
# loads with each PAN moved up two and its motion lane with it, the new sends at none.
wait 300
param 0 0 8 30
lane 0 0 8 3 90
param 1 0 7 100
lane 1 0 7 5 20
sndrev 2
tap SAVE
wait 300
reboot
wait 300
expect sound0.0.10 30
expect sound0.0.8 0
expect laneval0.0.10.3 90
expect laneval0.0.8.3 -1
expect sound1.0.9 100
expect sound1.0.7 0
expect laneval1.0.9.5 20
expect laneval1.0.7.5 -1
