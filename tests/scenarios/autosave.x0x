# AUTOSAVE (default ON): unsaved changes are saved by themselves while stopped, once nothing has been
# touched for 4 s, writing only the objects that changed; never while playing; never when OFF.
wait 300
expect store_writes 0
# a kick on steps 1 and 9, stopped
tapkey b0
tapkey w0
tapkey w8
wait 3000
expect store_writes 0
wait 1500
# the first save writes every object (nothing was on the flash yet)
expect store_writes 6
reboot
expect hit0.0.0 1
expect hit0.0.8 1
# one more step: only the patterns' object changes, so one write
wait 21000
tapkey w4
wait 4500
expect store_writes 7
# playing: an edit is not saved, however long it waits
tap PLAY
tapkey w12
wait 8000
expect store_writes 7
tap PLAY
wait 4500
expect store_writes 7
wait 8000
expect store_writes 8
expect hit0.0.12 1
# GLO > AUTOSAVE OFF (the tenth row): saved once more (the setting itself), then edits wait for SAVE
wait 21000
tap GLO
turn SELECT 9
turn ALGO -1
tap HOME
wait 5000
expect store_writes 9
tapkey w2
wait 25000
expect store_writes 9
reboot
expect hit0.0.2 0
tapkey w2
wait 25000
expect store_writes 9
